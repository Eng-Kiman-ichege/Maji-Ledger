# ──────────────────────────────────────────────────────────
# Maji Ledger — Backend Environment Variables Example
# Copy this file to appsettings.Development.json or use
# User Secrets (dotnet user-secrets) for local development.
# NEVER commit actual credentials to source control.
# ──────────────────────────────────────────────────────────

# SQL Server (Docker on local machine)
MAJI_DB_SERVER=localhost,1433
MAJI_DB_NAME=MajiLedgerDb
MAJI_DB_USER=sa
MAJI_DB_PASSWORD=YourStrongPassword!123

# Fully-formed connection string alternative
# ConnectionStrings__MajiLedgerDb=Server=localhost,1433;Database=MajiLedgerDb;User Id=sa;Password=...;TrustServerCertificate=True;

# CORS  origins (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://findings-calculation-believe-eligible.trycloudflare.com
udflare.com

# Payment provider keys (configure in later phases)
# MPESA_CONSUMER_KEY=
# MPESA_CONSUMER_SECRET=
# MPESA_SHORTCODE=
# MPESA_PASSKEY=
# AIRTEL_CLIENT_ID=
# AIRTEL_CLIENT_SECRET=

# STS / Token Platform (configure in later phases)
# STS_API_BASE_URL=
# STS_API_KEY=

# SMS gateway (configure in later phases)
# SMS_API_KEY=
# SMS_SENDER_ID=MajiLedger

# JWT (configure when auth is added)
# JWT_SECRET=
# JWT_ISSUER=MajiLedger
# JWT_AUDIENCE=MajiLedger
